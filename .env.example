# Didban API configuration. Copy to `.env` (never committed). Validated at startup; bad values stop the process.

# development | test | production. Production enforces an https hostname origin (spec §14.0).
NODE_ENV=development

# Interface and port the API listens on. Keep 127.0.0.1 behind Caddy/Nginx.
HOST=127.0.0.1
PORT=3000

# Public origin of the dashboard + API (same origin). Used for CSRF origin checks and cookies.
PUBLIC_ORIGIN=http://localhost:5173

# all | ingest | management: which route groups this process mounts (spec §14.0).
INSTANCE_ROLE=all

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Reverse proxies to trust for the client IP: a hop count (0 = none, 1 = Caddy on the same box)
# or a comma-separated CIDR list. Wrong values break geo and visitor hashing silently.
TRUST_PROXY=0

# Written by `pnpm db:setup` for local dev (dev-only random passwords). In production set them yourself.
# App role: DML only. Migrator role: DDL, used only by `pnpm db:migrate` / deploy.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Pool size per process. Rule: replicas x DB_POOL_MAX <= 0.8 x (max_connections - reserved) (spec §9.5).
DB_POOL_MAX=10

# Session cookie (spec §11). secure = __Host-sid, needs an https PUBLIC_ORIGIN; required in production.
# insecure-dev = plain `sid` without Secure, for local http only. Must be set explicitly for http.
SESSION_COOKIE=insecure-dev
