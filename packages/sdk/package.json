{
  "name": "@didban/analytics",
  "version": "0.1.0",
  "description": "Privacy-friendly browser SDK for didban, a self-hosted web analytics server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./outbound-links": {
      "types": "./dist/outbound-links.d.ts",
      "default": "./dist/outbound-links.js"
    },
    "./file-downloads": {
      "types": "./dist/file-downloads.d.ts",
      "default": "./dist/file-downloads.js"
    },
    "./scroll-depth": {
      "types": "./dist/scroll-depth.d.ts",
      "default": "./dist/scroll-depth.js"
    },
    "./engaged-time": {
      "types": "./dist/engaged-time.d.ts",
      "default": "./dist/engaged-time.js"
    },
    "./didban.iife.js": "./dist/didban.iife.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/didban.iife.js",
  "jsdelivr": "./dist/didban.iife.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sina-bre/didban.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && size-limit",
    "size": "size-limit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "import": "{ createAnalytics }",
      "limit": "5 KB",
      "gzip": true
    },
    {
      "name": "notFound",
      "path": "dist/index.js",
      "import": "{ notFound }",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "outbound-links",
      "path": "dist/outbound-links.js",
      "import": "{ outboundLinks }",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "file-downloads",
      "path": "dist/file-downloads.js",
      "import": "{ fileDownloads }",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "scroll-depth",
      "path": "dist/scroll-depth.js",
      "import": "{ scrollDepth }",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "engaged-time",
      "path": "dist/engaged-time.js",
      "import": "{ engagedTime }",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "script-tag (core + all modules)",
      "path": "dist/didban.iife.js",
      "limit": "6.5 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@didban/contracts": "workspace:*",
    "@size-limit/preset-small-lib": "14.2.0",
    "jsdom": "30.1.3",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
