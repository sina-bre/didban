{
  "name": "@didban/react",
  "version": "0.1.0",
  "description": "React adapter for @didban/analytics: AnalyticsProvider and useAnalytics.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sina-bre/didban.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && node scripts/check-directive.mjs && size-limit",
    "size": "size-limit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@didban/analytics": "^0.1.0",
    "react": ">=18"
  },
  "size-limit": [
    {
      "name": "react adapter",
      "path": "dist/index.js",
      "import": "{ AnalyticsProvider, useAnalytics }",
      "ignore": [
        "react",
        "@didban/analytics"
      ],
      "limit": "1 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@didban/analytics": "workspace:^",
    "@size-limit/preset-small-lib": "14.2.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
