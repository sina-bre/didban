{
  "name": "@didban/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@didban/contracts": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.5",
    "postgres": "3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate": "pnpm build && node --env-file-if-exists=../../.env dist/db/migrate-cli.js",
    "cli": "pnpm --silent build && node --env-file-if-exists=../../.env dist/cli/cli.js",
    "migrate:test": "pnpm build && node --env-file-if-exists=../../.env dist/db/migrate-cli.js --test"
  }
}
